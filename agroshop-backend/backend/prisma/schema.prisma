// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Pastikan ini sesuai dengan database Anda (mysql / postgresql)
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

// ==================== TABEL CATEGORY ====================
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String
  imageUrl  String
  
  products  Product[]
}

// ==================== TABEL PRODUCT ====================
model Product {
  id            Int        @id @default(autoincrement())
  name          String
  description   String     @db.Text
  price         Float
  discountPrice Float?     
  imageUrl      String
  images        String[]   
  stock         Int
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  isFeatured    Boolean    @default(false)
  isAvailable   Boolean    @default(true)
  unit          String     

  category      Category   @relation(fields: [categoryId], references: [id])
  categoryId    Int

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

// ==================== TABEL USER ====================
model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String    
  role        Role      @default(FARMER) 
  phone       String?   
  imageUrl    String?   
  address     String?   @db.Text
  joinedDate  DateTime? @default(now())

  cartItems  CartItem[]
  orders     Order[]
  addresses  Address[]
}

// Enum untuk Role User
enum Role {
  ADMIN
  FARMER
}

// ==================== TABEL CART ITEM ====================
model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  addedAt   DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  productId Int

  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

// ==================== TABEL ORDER / RIWAYAT PESANAN ====================
model Order {
  id        Int         @id @default(autoincrement())
  orderCode String     @unique
  status    OrderStatus @default(PROCESSING)
  total     Float
  shippingAddress String? @db.Text
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id])
  userId    Int

  items     OrderItem[]
  shipment  Shipment?
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  quantity    Int
  price       Float
  productName String

  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int

  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

// ==================== TABEL ALAMAT PENGIRIMAN ====================
model Address {
  id        Int      @id @default(autoincrement())
  label     String
  name      String
  phone     String
  detail    String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

// ==================== TABEL PENGIRIMAN / TRACKING ====================
model Shipment {
  id             Int            @id @default(autoincrement())
  courier        String?
  trackingNumber String?
  status         ShipmentStatus @default(WAITING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order          Order          @relation(fields: [orderId], references: [id])
  orderId        Int            @unique
  events         ShipmentEvent[]
}

model ShipmentEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  location    String?
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId  Int
}

enum ShipmentStatus {
  WAITING
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// ==================== TABEL BANNER ====================
model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String
  imageUrl  String
}
